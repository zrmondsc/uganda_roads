@article{meiCoANetConnectivityAttention2021,
  title = {{{CoANet}}: {{Connectivity Attention Network}} for {{Road Extraction From Satellite Imagery}}},
  shorttitle = {{{CoANet}}},
  author = {Mei, Jie and Li, Rou-Jing and Gao, Wang and Cheng, Ming-Ming},
