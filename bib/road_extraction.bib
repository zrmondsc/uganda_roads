@article{jiangAGDLinknetRoadSemantic2023,
  title = {{{AGD-Linknet}}: {{A Road Semantic Segmentation Model}} for {{High Resolution Remote Sensing Images Integrating Attention Mechanism}}, {{Gated Decoding Block}} and {{Dilated Convolution}}},
  shorttitle = {{{AGD-Linknet}}},
  author = {Jiang, Yinan and Zhong, Chaoliang and Zhang, Botao},
  date = {2023},
  journaltitle = {IEEE Access},
